# Copy this file to .env and choose ONE provider.
# Never commit your real .env file to GitHub.

# Option 1 (recommended): local Ollama, free and unlimited, no key needed
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b

# Option 2: Groq free tier (cloud). Get a key at https://console.groq.com
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.1-8b-instant
# GROQ_API_KEY=your_key_here

# Option 3: Google Gemini free tier. Get a key at https://aistudio.google.com
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash
# GEMINI_API_KEY=your_key_here
